# Supabase — development project (regio Frankfurt)
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore en hoort daar te blijven.

# Project URL, bijv. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publieke anon key. Veilig voor de browser, RLS beschermt de data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NOOIT in de client bundle, alleen server-side.
# Nog niet nodig voor de basisopzet; toevoegen zodra er server-side
# admin-taken zijn.
# SUPABASE_SERVICE_ROLE_KEY=

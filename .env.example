# Supabase — development project (regio Frankfurt)
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore en hoort daar te blijven.

# Project URL, bijv. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publieke anon key. Veilig voor de browser, RLS beschermt de data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NOOIT in de client bundle, alleen server-side.
# Nodig voor de dagelijkse vacature-scan (cron draait zonder sessie).
# Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Geheim voor de cron-route /api/radar/scan. Zelf een lange random
# string kiezen. Vercel Cron mag ook zonder (herkend aan x-vercel-cron).
RADAR_CRON_SECRET=

# Anthropic API — alleen server-side, voor de AI-generatoren (fase 3).
# Nodig zodra je /tools/generator/* gebruikt.
ANTHROPIC_API_KEY=
# Optioneel: overschrijf het standaardmodel.
# ANTHROPIC_MODEL=claude-sonnet-5
